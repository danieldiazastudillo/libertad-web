---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Sitio conmemorativo del centésimo décimo aniversario de la Respetable Logia Abnegación N°48, Viña del Mar, Chile." } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>

---
import { getEntry, getCollection, render } from "astro:content";
import { getImage, Image } from "astro:assets";
import Layout from "../layouts/Layout.astro";
import Seal from "../components/brand/Seal.astro";
import Eyebrow from "../components/core/Eyebrow.astro";
import Divider from "../components/core/Divider.astro";
import Badge from "../components/core/Badge.astro";
import Card from "../components/core/Card.astro";
import { RsvpForm } from "../components/forms/RsvpForm";
import duskBg from "../assets/images/club-libertad-dusk-overlay.jpg";
import nightBg from "../assets/images/club-libertad-night-overlay.jpg";
import wireframeSvg from "../assets/images/column-wireframe.svg";

const heroEntry = await getEntry("site", "hero");
const navEntry = await getEntry("site", "nav");
const agendaEntry = await getEntry("site", "agenda");
const lodgesEntry = await getEntry("site", "lodges");
const rsvpEntry = await getEntry("site", "rsvp");
const footerEntry = await getEntry("site", "footer");
if (!heroEntry || !navEntry || !agendaEntry || !lodgesEntry || !rsvpEntry || !footerEntry) {
  throw new Error("Missing required site.yaml entry — see src/content/site.yaml");
}
const hero = heroEntry.data;
const nav = navEntry.data;
const agenda = agendaEntry.data;
const lodges = lodgesEntry.data;
const rsvp = rsvpEntry.data;
const footer = footerEntry.data;

const events = (await getCollection("events")).sort((a, b) => a.data.order - b.data.order);

const [historiaEntry] = await getCollection("historia");
if (!historiaEntry) throw new Error("Missing src/content/historia/*.md entry");
const { Content: HistoriaContent } = await render(historiaEntry);

const heroBg = await getImage({ src: duskBg, width: 1920, format: "webp", quality: 80 });
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const invitacionHref = `${base}/invitacion/`;
---

<Layout title="110° Aniversario · Resp∴ Log∴ Abnegación N°48">
  <div class="page-wrap">
    <img src={wireframeSvg.src} class="wireframe wireframe-left" alt="" />
    <img src={wireframeSvg.src} class="wireframe wireframe-right" alt="" />

    <nav class="nav">
      <div class="nav-inner">
        <span class="nav-brand">{nav.brand}</span>
        <div class="nav-links">
          {nav.links.map((link: { label: string; href: string }) => (
            <a class="nav-link" href={link.href}>{link.label}</a>
          ))}
        </div>
      </div>
    </nav>

    <div class="hero-outer" style={`background-image:url(${heroBg.src})`}>
      <div class="hero-fade"></div>
      <div class="hero">
        <Eyebrow>{hero.eyebrow}</Eyebrow>
        <div class="years">
          <span class="year-text">{hero.yearStart}</span>
          <Seal size={132} glow />
          <span class="year-text">{hero.yearEnd}</span>
        </div>
        <h1 class="hero-title">{hero.title}</h1>
        <div class="hero-ordinal">{hero.ordinal}</div>
        <div class="hero-tagline">{hero.tagline}</div>
        <p class="hero-intro">{hero.intro}</p>
        <div class="hero-badges">
          <Badge tone="gold">{hero.dateBadge}</Badge>
          <Badge tone="outline">{hero.timeBadge}</Badge>
          <Badge tone="outline">{hero.modeBadge}</Badge>
        </div>
      </div>
    </div>

    <section id="aniversario" class="section">
      <Eyebrow>Aniversario</Eyebrow>
      <h2 class="section-heading">Actividades Conmemorativas</h2>
      <div>
        {events.map((event, i) => (
          <div class="event-row" style={i < events.length - 1 ? "border-bottom: 1px solid var(--border-on-dark)" : ""}>
            <div class="event-date">
              <span class="event-day">{event.data.day}</span>
              <span class="event-month">{event.data.month}</span>
            </div>
            <div>
              <div class="event-title">{event.data.title}</div>
              <div class="event-info">{event.data.info}</div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <Divider />

    <div class="section grid-2">
      <Card tone="dark">
        <Eyebrow>{agenda.eyebrow}</Eyebrow>
        <ul class="agenda-list">
          {agenda.items.map((item: string) => <li>{item}</li>)}
        </ul>
      </Card>
      <Card tone="dark">
        <Eyebrow>{lodges.eyebrow}</Eyebrow>
        <p class="lodges-text">{lodges.text}</p>
      </Card>
    </div>

    <Divider />

    <section id="historia" class="section">
      <Eyebrow>{historiaEntry.data.eyebrow}</Eyebrow>
      <h2 class="section-heading">{historiaEntry.data.heading}</h2>
      <div class="historia-body">
        <HistoriaContent />
      </div>
      <div class="historia-images">
        <Image src={duskBg} alt="Club Libertad al atardecer" width={900} loading="eager" class="historia-image" />
        <Image src={nightBg} alt="Club Libertad, fachada nocturna" width={900} loading="eager" class="historia-image" />
      </div>
    </section>

    <Divider label="Confirmar Asistencia" />

    <div id="rsvp" class="rsvp-wrap">
      <RsvpForm
        client:visible
        nameLabel={rsvp.nameLabel}
        namePlaceholder={rsvp.namePlaceholder}
        lodgeLabel={rsvp.lodgeLabel}
        lodgePlaceholder={rsvp.lodgePlaceholder}
        emailLabel={rsvp.emailLabel}
        emailPlaceholder={rsvp.emailPlaceholder}
        submitLabel={rsvp.submitLabel}
        successMessage={rsvp.successMessage}
      />
    </div>

    <footer class="page-footer">
      <p class="footer-text">{footer.text}</p>
      <p class="footer-link"><a href={invitacionHref}>Ver invitación imprimible</a></p>
    </footer>
  </div>
</Layout>

<style>
  .page-wrap {
    position: relative;
    min-height: 100vh;
    background: var(--navy-950);
    color: var(--text-on-dark-primary);
    font-family: var(--font-serif);
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow-x: hidden;
  }

  .wireframe {
    position: fixed;
    top: -4%;
    height: 108vh;
    opacity: 0.12;
    z-index: 0;
    pointer-events: none;
    mix-blend-mode: screen;
  }
  .wireframe-left { left: -4%; }
  .wireframe-right { right: -4%; }

  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    width: 100%;
    box-sizing: border-box;
    background: var(--navy-950);
    border-bottom: 1px solid var(--border-on-dark);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .nav-inner {
    width: 100%;
    max-width: var(--container-narrow);
    padding: var(--space-3) var(--space-5);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-brand {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-on-dark-primary);
  }
  .nav-links { display: flex; gap: var(--space-6); }
  .nav-link {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--text-on-dark-secondary);
    text-decoration: none;
  }
  .nav-link:hover { color: var(--gold-500); }

  .hero-outer {
    width: 100%;
    position: relative;
    background-size: cover;
    background-position: center 20%;
    display: flex;
    justify-content: center;
    z-index: 1;
  }
  .hero-fade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, var(--navy-950) 0%, transparent 16%, transparent 72%, var(--navy-950) 100%);
  }
  .hero {
    width: 100%;
    max-width: var(--container-narrow);
    padding: var(--space-9) var(--space-5) var(--space-8);
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-4);
    position: relative;
    z-index: 1;
  }
  .years { display: flex; align-items: center; gap: var(--space-6); margin: var(--space-5) 0; }
  .year-text {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--navy-300);
    letter-spacing: var(--tracking-wide);
  }
  .hero-title {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: 0;
    font-weight: 400;
  }
  .hero-ordinal {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    letter-spacing: var(--tracking-normal);
    color: var(--text-accent-gold);
    line-height: 1;
  }
  .hero-tagline {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: var(--text-accent-gold);
  }
  .hero-intro {
    font: var(--font-body-lg);
    color: var(--text-on-dark-secondary);
    max-width: 520px;
  }
  .hero-badges {
    display: flex;
    gap: var(--space-3);
    flex-wrap: wrap;
    justify-content: center;
    margin-top: var(--space-2);
  }

  .section {
    width: 100%;
    max-width: var(--container-narrow);
    padding: var(--space-8) var(--space-5);
    position: relative;
    z-index: 1;
  }
  .section-heading {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-2xl);
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    margin: var(--space-3) 0 var(--space-5);
  }

  .event-row {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    padding: var(--space-5) 0;
    text-align: left;
  }
  .event-date {
    display: flex;
    flex-direction: column;
    align-items: center;
    line-height: 1;
    min-width: 84px;
  }
  .event-day {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: var(--text-4xl);
    color: var(--text-on-dark-primary);
  }
  .event-month {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    letter-spacing: var(--tracking-widest);
    color: var(--text-accent-gold);
    text-transform: uppercase;
    margin-top: 4px;
  }
  .event-title {
    font: var(--font-heading-md);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }
  .event-info {
    font: var(--font-body);
    color: var(--text-on-dark-secondary);
    margin-top: 4px;
  }

  .grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
  }

  .agenda-list, .lodges-text {
    font: var(--font-body);
    color: var(--text-on-dark-secondary);
    margin: var(--space-3) 0 0;
  }
  .agenda-list { padding-left: 1.1em; }

  .historia-body :global(p) {
    font: var(--font-body-lg);
    color: var(--text-on-dark-secondary);
    max-width: 640px;
    margin: 0 0 var(--space-3);
  }
  .historia-images {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-4);
    margin-top: var(--space-6);
  }
  .historia-image {
    width: 100%;
    height: 260px;
    object-fit: cover;
  }

  .rsvp-wrap {
    width: 100%;
    max-width: 460px;
    padding: var(--space-8) var(--space-5);
    position: relative;
    z-index: 1;
  }

  .page-footer {
    padding: var(--space-6) var(--space-5) var(--space-8);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .footer-text {
    font: var(--font-caption);
    color: var(--text-on-dark-muted);
  }
  .footer-link {
    font: var(--font-caption);
    margin-top: var(--space-2);
  }
  .footer-link a {
    color: var(--text-accent-gold);
  }

  @media (max-width: 640px) {
    .grid-2, .historia-images {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .nav-inner {
      flex-wrap: wrap;
      justify-content: center;
      row-gap: var(--space-2);
    }
    .nav-links {
      gap: var(--space-4);
    }
  }
</style>

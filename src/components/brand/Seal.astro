---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import defaultSeal from "../../assets/images/logo-abnegacion-azul-alpha.png";

export interface Props {
  /** Diameter in px. */
  size?: number;
  /** Adds a subtle gold-ring glow — for hero/cover placements only. */
  glow?: boolean;
  /** Astro ImageMetadata for the seal image, defaults to the design system's own asset. */
  src?: ImageMetadata;
}

const { size = 120, glow = false, src = defaultSeal } = Astro.props;
---

<div class="seal" style={`--seal-size: ${size}px; --seal-glow: ${glow ? "0 0 0 1px var(--border-gold), var(--shadow-seal)" : "none"};`}>
  <Image
    src={src}
    alt="Resp∴ Log∴ Abnegación N°48"
    width={size}
    height={size}
  />
</div>

<style>
  .seal {
    --seal-size: 120px;
    --seal-glow: none;
    width: var(--seal-size);
    height: var(--seal-size);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: var(--seal-glow);
  }

  .seal :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
</style>
